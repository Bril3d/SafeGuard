models/
reports/
mlruns/
mlartifacts/
mlflow.db
runs/
logs/
*.zip
*.tar.gz
*.pt
*.pth
*.onnx
*.onnx.data
*.engine

# Frontend build/test artifacts rebuilt inside multi-stage Docker
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
