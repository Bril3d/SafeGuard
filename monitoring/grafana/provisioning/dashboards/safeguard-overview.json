{
  "title": "SafeGuard Production Inference & PPE Telemetry",
  "uid": "safeguard-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Total Inference Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(safeguard_inference_requests_total)", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Prediction Error Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(safeguard_prediction_errors_total)", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "ONNX Inference P95 Latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(safeguard_inference_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Detections by Canonical Class",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (class_name) (safeguard_detections_by_class_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Proxy Mean Prediction Confidence",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "rate(safeguard_prediction_confidence_sum[5m]) / clamp_min(rate(safeguard_prediction_confidence_count[5m]), 1)",
          "refId": "A"
        }
      ]
    }
  ]
}
