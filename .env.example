# SafeGuard Environment Configuration Template
# Copy to .env for local overrides. Never commit .env or credentials to Git.

SAFEGUARD_ENV=development
SAFEGUARD_API_TITLE=SafeGuard API
SAFEGUARD_API_VERSION=0.1.0
SAFEGUARD_LOG_LEVEL=INFO
SAFEGUARD_MODEL_VERSION=unloaded
SAFEGUARD_MODEL_PATH=models/production/safeguard_yolo11s.onnx
SAFEGUARD_CONF_THRESHOLD=0.25
SAFEGUARD_IOU_THRESHOLD=0.50
SAFEGUARD_COMPLIANCE_CONFIRM_FRAMES=3
SAFEGUARD_COMPLIANCE_COOLDOWN_SECONDS=10.0
SAFEGUARD_COMPLIANCE_CAPTURE_EVIDENCE=true
SAFEGUARD_PREDICTION_LOG_PATH=logs/predictions.jsonl
SAFEGUARD_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Ports (used by Docker Compose and local dev)
BACKEND_PORT=8000
FRONTEND_PORT=3000
MLFLOW_PORT=5000
PREFECT_PORT=4200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Grafana local admin bootstrap (override via local .env outside Git)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme-local-only

# Frontend build/dev API base URL
VITE_API_BASE_URL=http://localhost:8000

# MLflow & Prefect URIs
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
